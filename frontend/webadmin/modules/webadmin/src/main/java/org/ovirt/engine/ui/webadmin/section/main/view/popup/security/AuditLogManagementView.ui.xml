<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
    xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:b="urn:import:org.gwtbootstrap3.client.ui">

    <ui:with field="constants" type="org.ovirt.engine.ui.webadmin.ApplicationConstants" />

    <ui:style>
        .mainPanel {
            padding: 20px;
            width: 100%;
        }

        .sectionPanel {
            margin-top: 20px;
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .sectionTitle {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .buttonPanel {
            margin-top: 15px;
        }

        .actionButton {
            margin-right: 15px;
        }

        .statusLabel {
            padding: 10px;
            font-weight: bold;
            color: #5cb85c;
        }
    </ui:style>

    <g:FlowPanel addStyleNames="{style.mainPanel}">
        <!-- Audit Log Protection Section -->
        <g:FlowPanel addStyleNames="{style.sectionPanel}">
            <g:HTML addStyleNames="{style.sectionTitle}">
                <ui:text from="{constants.auditLogProtection}" />
            </g:HTML>

            <g:HorizontalPanel addStyleNames="{style.buttonPanel}">
                <b:Button ui:field="fullLogBackupButton"
                          text="{constants.fullLogBackup}"
                          type="PRIMARY"
                          addStyleNames="{style.actionButton}" />
                <g:Label ui:field="fullLogBackupStatusLabel"
                         text="{constants.statusNormal}"
                         addStyleNames="{style.statusLabel}" />
            </g:HorizontalPanel>
        </g:FlowPanel>

        <!-- Audit Log Remote Backup Section -->
        <g:FlowPanel addStyleNames="{style.sectionPanel}">
            <g:HTML addStyleNames="{style.sectionTitle}">
                <ui:text from="{constants.auditLogRemoteBackup}" />
            </g:HTML>

            <g:HorizontalPanel addStyleNames="{style.buttonPanel}">
                <b:Button ui:field="remoteBackupButton"
                          text="{constants.remoteAddressRsyslog}"
                          type="PRIMARY"
                          addStyleNames="{style.actionButton}" />
                <g:Label ui:field="remoteBackupStatusLabel"
                         text="{constants.statusNormal}"
                         addStyleNames="{style.statusLabel}" />
            </g:HorizontalPanel>
        </g:FlowPanel>

        <!-- Availability Assurance Section -->
        <g:FlowPanel addStyleNames="{style.sectionPanel}">
            <g:HTML addStyleNames="{style.sectionTitle}">
                <ui:text from="{constants.availabilityAssurance}" />
            </g:HTML>

            <g:HorizontalPanel addStyleNames="{style.buttonPanel}">
                <b:Button ui:field="engineBackupButton"
                          text="{constants.runEngineBackup}"
                          type="PRIMARY"
                          addStyleNames="{style.actionButton}" />
                <g:Label ui:field="engineBackupStatusLabel"
                         text="{constants.statusNormal}"
                         addStyleNames="{style.statusLabel}" />
            </g:HorizontalPanel>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
