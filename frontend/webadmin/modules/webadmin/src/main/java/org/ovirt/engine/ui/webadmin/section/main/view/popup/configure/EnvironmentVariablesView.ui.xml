<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
    xmlns:c="urn:import:com.google.gwt.user.cellview.client">

    <g:HTMLPanel styleName="content-area">
        <g:VerticalPanel width="100%" spacing="8">
            <g:HorizontalPanel spacing="6">
                <g:Label text="키" />
                <g:TextBox ui:field="keyTextBox" width="260px" />
                <g:Label text="값" />
                <g:TextBox ui:field="valueTextBox" width="260px" />
                <b:Button ui:field="refreshButton" text="조회" />
                <b:Button ui:field="queryButton" text="값 조회" />
                <b:Button ui:field="updateButton" text="수정" />
            </g:HorizontalPanel>

            <g:ScrollPanel width="100%" height="420px">
                <c:CellTable ui:field="configTable" width="100%" />
            </g:ScrollPanel>

            <g:HTML ui:field="resultLabel" />
        </g:VerticalPanel>
    </g:HTMLPanel>
</ui:UiBinder>
