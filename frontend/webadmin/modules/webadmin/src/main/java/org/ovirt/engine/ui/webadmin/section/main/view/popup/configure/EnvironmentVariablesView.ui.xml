<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:b="urn:import:org.gwtbootstrap3.client.ui">

    <g:HTMLPanel styleName="content-area" width="100%">
        <g:VerticalPanel width="100%" spacing="0">
            <g:HTML>
                <div style="display:inline-block; margin:6px 0 6px 6px; padding:4px 12px; background:#0f6586; color:#fff; border:1px solid #003d5a; border-radius:4px; font-size:18px; line-height:1.2;">엔진 환경 변수 관리</div>
            </g:HTML>

            <g:HTML><div style="height:1px; background:#cfcfcf; margin:0 0 8px 0;"></div></g:HTML>

            <g:HTML>
                <div style="display:inline-block; margin:0 0 4px 12px; padding:3px 10px; background:#0f6586; color:#fff; border:1px solid #003d5a; border-radius:4px; font-size:14px; line-height:1.2;">변수 이름 조회</div>
            </g:HTML>

            <g:HorizontalPanel spacing="6" verticalAlignment="ALIGN_MIDDLE" width="100%">
                <g:HTML><div style="width:12px;"></div></g:HTML>
                <g:TextBox ui:field="keyTextBox" width="560px" />
                <b:Button ui:field="queryButton" text="조회" icon="SEARCH" />
            </g:HorizontalPanel>

            <g:HTML><div style="margin:6px 0 8px 14px; font-size:12px; color:#333;">engine-config -g &lt;KEY&gt;</div></g:HTML>

            <g:HTML><div style="height:1px; background:#cfcfcf; margin:0 0 8px 0;"></div></g:HTML>

            <g:HTML>
                <div style="display:inline-block; margin:0 0 4px 12px; padding:3px 10px; background:#0f6586; color:#fff; border:1px solid #003d5a; border-radius:4px; font-size:14px; line-height:1.2;">구성 결과</div>
            </g:HTML>

            <g:HorizontalPanel spacing="0" width="100%" verticalAlignment="ALIGN_MIDDLE">
                <g:HTML><div style="width:12px;"></div></g:HTML>
                <g:Label text="Key" width="230px" />
                <g:Label text="Value" width="320px" />
                <g:Label text="설명" width="250px" />
            </g:HorizontalPanel>

            <g:HorizontalPanel spacing="8" width="100%" verticalAlignment="ALIGN_MIDDLE">
                <g:HTML><div style="width:12px;"></div></g:HTML>
                <g:Label ui:field="queriedKeyLabel" width="230px" />
                <g:HorizontalPanel spacing="8" width="320px" verticalAlignment="ALIGN_MIDDLE">
                    <g:TextBox ui:field="valueTextBox" width="180px" />
                    <b:Button ui:field="updateButton" text="수정" icon="EDIT" />
                </g:HorizontalPanel>
                <g:Label ui:field="queriedDescriptionLabel" width="250px" />
            </g:HorizontalPanel>

            <g:HTML><div style="margin:6px 0 0 14px; font-size:12px; color:#333;">수정: engine-config -s &lt;KEY&gt;=&lt;VALUE&gt;</div></g:HTML>
            <g:HTML ui:field="resultLabel" />

            <g:HTML><div style="height:1px; background:#cfcfcf; margin:10px 0 0 0;"></div></g:HTML>
        </g:VerticalPanel>
    </g:HTMLPanel>
</ui:UiBinder>
