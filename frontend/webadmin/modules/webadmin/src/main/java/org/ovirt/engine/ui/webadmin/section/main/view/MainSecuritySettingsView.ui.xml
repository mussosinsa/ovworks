<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
    xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">

    <ui:style>
        .mainContainer {
            display: table;
            width: 100%;
            height: 100%;
            background-color: #f5f5f5;
        }

        .sidebar {
            display: table-cell;
            width: 250px;
            height: 100%;
            vertical-align: top;
            background-color: #ffffff;
            border-right: 1px solid #ddd;
            overflow: visible !important;
        }

        .sidebarTitle {
            padding: 8px 12px;
            font-size: 16px;
            font-weight: bold;
            border-bottom: 1px solid #ddd;
            background-color: #f8f8f8;
        }

        .menuList {
            display: block;
            overflow: visible !important;
        }

        .menuItem {
            display: block !important;
            padding: 8px 12px;
            cursor: pointer;
            border-bottom: 1px solid #f0f0f0;
            font-size: 13px;
            line-height: 1.3;
            visibility: visible !important;
        }

        .menuItem:hover {
            background-color: #f8f8f8;
        }

        .menuItemActive {
            background-color: #337ab7;
            color: white;
            font-weight: bold;
        }

        .menuItemActive:hover {
            background-color: #286090;
        }

        .contentArea {
            display: table-cell;
            vertical-align: top;
            background-color: #ffffff;
            padding: 0;
            height: 100%;
        }

        .viewContainer {
            width: 100%;
            height: 100%;
        }
    </ui:style>

    <g:HTMLPanel addStyleNames="{style.mainContainer}">
        <div class="{style.sidebar}">
            <div class="{style.sidebarTitle}">보안 설정</div>
            <div class="{style.menuList}">
                <div ui:field="integrityCheckMenuItem" class="{style.menuItem} {style.menuItemActive}">무결성 검사</div>
                <div ui:field="clientManagementMenuItem" class="{style.menuItem}">클라이언트 관리</div>
                <div ui:field="auditLogManagementMenuItem" class="{style.menuItem}">감사기록 관리</div>
            </div>
        </div>
        <div class="{style.contentArea}">
            <g:SimplePanel ui:field="contentPanel" addStyleNames="{style.viewContainer}"/>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>
