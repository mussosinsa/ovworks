#!/bin/sh

set -eu

DEST_DIR="${1:-}"

if [ "$#" -ne 1 ]; then
    echo "FAIL: 저장 위치 인자는 하나만 허용됩니다." 1>&2
    exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
    echo "FAIL: 전체 로그 백업은 root 권한으로 실행해야 합니다." 1>&2
    exit 1
fi

if [ -z "${DEST_DIR}" ]; then
    echo "FAIL: 저장 위치가 필요합니다." 1>&2
    exit 1
fi

case "${DEST_DIR}" in
    /*) ;;
    *)
        echo "FAIL: 저장 위치는 절대 경로여야 합니다." 1>&2
        exit 1
        ;;
esac

if [ "${DEST_DIR}" = "/" ]; then
    echo "FAIL: 루트 디렉터리는 저장 위치로 사용할 수 없습니다." 1>&2
    exit 1
fi

umask 077
mkdir -p -- "${DEST_DIR}"
resolved_dir="$(readlink -f -- "${DEST_DIR}")"
[ "${resolved_dir}" != "/" ] || {
    echo "FAIL: 루트 디렉터리는 저장 위치로 사용할 수 없습니다." 1>&2
    exit 1
}

timestamp="$(date +%Y%m%d%H%M%S)"
archive="${resolved_dir%/}/${timestamp}.tar.gz"
temporary_archive="$(mktemp "${resolved_dir%/}/.${timestamp}.XXXXXX")"
trap 'rm -f -- "${temporary_archive}"' EXIT HUP INT TERM

if /bin/tar --ignore-failed-read -czf "${temporary_archive}" -C /var/log ovirt-engine; then
    if [ -e "${archive}" ] || [ -L "${archive}" ]; then
        echo "FAIL: 동일 시각의 백업 파일이 이미 존재합니다: ${archive}" 1>&2
        exit 1
    fi
    mv -- "${temporary_archive}" "${archive}"
    trap - EXIT HUP INT TERM
    echo "SUCCESS: ${archive}"
    exit 0
fi

if [ -s "${temporary_archive}" ]; then
    if [ -e "${archive}" ] || [ -L "${archive}" ]; then
        echo "FAIL: 동일 시각의 백업 파일이 이미 존재합니다: ${archive}" 1>&2
        exit 1
    fi
    mv -- "${temporary_archive}" "${archive}"
    trap - EXIT HUP INT TERM
    echo "SUCCESS (with warnings): ${archive}"
    exit 0
fi

echo "FAIL: ${archive}"
exit 1
