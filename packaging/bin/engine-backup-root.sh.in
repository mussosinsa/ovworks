#!/bin/sh

set -eu

BACKUP_ROOT="/var/lib/ovirt-engine-backup"
DEST_DIR="${1:-}"

if [ "$#" -ne 1 ]; then
    echo "FAIL: 저장 위치 인자는 하나만 허용됩니다." 1>&2
    exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
    echo "FAIL: 엔진 백업은 root 권한으로 실행해야 합니다." 1>&2
    exit 1
fi

if [ -z "${DEST_DIR}" ]; then
    echo "FAIL: 저장 위치가 필요합니다." 1>&2
    exit 1
fi

case "${DEST_DIR}" in
    "${BACKUP_ROOT}"|"${BACKUP_ROOT}"/*) ;;
    *)
        echo "FAIL: 저장 위치는 ${BACKUP_ROOT} 내부여야 합니다." 1>&2
        exit 1
        ;;
esac

umask 077
mkdir -p -- "${DEST_DIR}"
resolved_dir="$(readlink -f -- "${DEST_DIR}")"
case "${resolved_dir}" in
    "${BACKUP_ROOT}"|"${BACKUP_ROOT}"/*) ;;
    *)
        echo "FAIL: 심볼릭 링크를 통한 백업 경로 이탈이 감지되었습니다." 1>&2
        exit 1
        ;;
esac
chown root:root -- "${resolved_dir}"
chmod 0700 -- "${resolved_dir}"

exec /usr/bin/engine-backup \
    --mode=backup \
    --file="${resolved_dir}/engine_backup.tar.gz" \
    --log="${resolved_dir}/engine_backup.log"
